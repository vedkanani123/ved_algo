# Browser-safe configuration (these two values are safe to expose)
NEXT_PUBLIC_SUPABASE_URL=https://oefrwjdefqnpsubuxpmu.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace_with_current_publishable_key

# Server-only values: set these in Vercel. Never commit them.
SUPABASE_SERVICE_ROLE_KEY=replace_with_service_role_key
OWNER_EMAIL=your-owner-email@example.com
# A server-only scrypt hash of the fixed 16-digit owner access code.
OWNER_ACCESS_CODE_HASH=scrypt$base64url_salt$base64url_hash
# 32-byte base64 key: openssl rand -base64 32
LICENSE_ENCRYPTION_KEY=replace_with_32_byte_base64_key
# Used for approved origins; production must be your HTTPS dashboard origin.
APP_ORIGIN=https://licenses.example.com
